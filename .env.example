# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Postgres connection string.
# Railway injects this automatically when the Postgres plugin is attached.
# For local dev: postgres://postgres:dev@localhost:5432/postgres
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# HTTP port. Railway sets this automatically; defaults to 3000 locally.
PORT=3000

# Basic-auth password for DELETE /admin/wipe. Set a strong secret in production.
ADMIN_PASSWORD=changeme

# Set to "production" on Railway.
NODE_ENV=development
