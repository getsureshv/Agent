# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Postgres connection string.
# Render injects this automatically via the DATABASE_URL env var when linked to a Render Postgres database.
# For local dev: postgres://postgres:dev@localhost:5432/postgres
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# HTTP port. Render sets this automatically; defaults to 3000 locally.
PORT=3000

# Basic-auth password for DELETE /admin/wipe. Set a strong secret in production.
ADMIN_PASSWORD=changeme

# v3 session secret. DB-backed sessions don't strictly require this today
# (the cookie holds an opaque session id), but it's reserved for future
# signed-cookie or JWT use. On Render this is auto-generated via render.yaml
# (generateValue: true) — generate locally with:
#   node -e 'console.log(require("node:crypto").randomBytes(64).toString("hex"))'
SESSION_SECRET=changeme-64-random-hex-bytes

# Set to "production" on Render.
NODE_ENV=development
